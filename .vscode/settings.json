// Local VS Code Extension Configurations
// 6737osl Windows workstation for ML/Geospatial workflows
{
  "files.associations": {
    "**/CODEOWNERS": "plaintext"
  },

  // Terminal
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "terminal.integrated.defaultProfile.linux": "Bash",

  // Profiles, Editors, and Themes
  "editor.rulers": [
    { "column": 88, "color": "#737171" },
  ],
  "editor.tabSize": 2,
  "workbench.colorCustomizations": {
    "activityBar.background": "#181818",
    "titleBar.activeBackground": "#181818",
    "titleBar.activeForeground": "#cccccc"
  },

  // Python formatting
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
  },
  "autoDocstring.docstringFormat": "one-line-sphinx",
  // Python Environment settings
  "python.useEnvironmentsExtension": false,
  "python.terminal.activateEnvironment": true,
  // Pixi default
  "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/gpu/python.exe",

  // UV default
  // "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  // Conda ArcGIS Pro default 
  // "python.defaultInterpreterPath": "${env:USERPROFILE}\\AppData\\Local\\ESRI\\conda\\envs\\arcgis-azure-v35\\python.exe",

  // Ruff formatting 
  "ruff.importStrategy": "useBundled",
  "ruff.interpreter": [
    "${workspaceFolder}/.pixi/envs/gpu/python.exe"
  ],

  // YAML formatting
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[yml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // TOML formatting
  "[toml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "evenBetterToml.formatter.allowedBlankLines": 2,

  // Markdown formatting
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // Markdown Table of Contents settings
  "markdown.extension.toc.levels": "2..2",
  "markdown.extension.toc.updateOnSave": true,

  // Git
  "git.branchProtection": ["main"],
  "git.allowNoVerifyCommit": true,
  "git.confirmNoVerifyCommit": false,

  // Docker
  "containers.contexts.showInStatusBar": true,

  "[plaintext]": {
    "editor.formatOnSave": false
  },
  "python-envs.defaultEnvManager": "ms-python.python:system",
}
